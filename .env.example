# Copiar como .env.local y completar con los valores del proyecto Supabase.
# .env.local está en el .gitignore: nunca se sube al repo.
# La publishable key (sb_publishable_…) va en EXPO_PUBLIC_SUPABASE_ANON_KEY.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
